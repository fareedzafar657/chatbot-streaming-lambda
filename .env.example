# Required — create a Cognito User Pool and copy these from the AWS console
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=<your-app-client-id>

# AWS region — must match where your DynamoDB tables and Bedrock access live
AWS_REGION=us-east-1

# Local dev server port
PORT=4000

# CORS origin for the local dev server (lock down to your frontend origin in staging/prod)
CORS_ORIGIN=*

# System prompt injected into every conversation (optional override)
SYSTEM_PROMPT=You are a helpful, concise assistant. Respond clearly and directly.

# Bedrock inference parameters
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.7
BEDROCK_TOP_P=0.9

# History limits sent to Bedrock
HISTORY_MAX_MESSAGES=50
HISTORY_MAX_TOKEN_BUDGET=60000

# DynamoDB table names (must match what you created)
DYNAMO_MESSAGES_TABLE=chatbot_messages
DYNAMO_BRANCHES_TABLE=chatbot_branches
DYNAMO_SESSIONS_TABLE=chatbot_sessions
